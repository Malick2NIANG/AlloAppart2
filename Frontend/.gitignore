# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supports marketing / sorties d'outils — hors application, non versionnés
/motion/
/Claude outputs/

# e2e (Playwright) — disposable run artifacts and session storage state
/e2e/screenshots/
/e2e/*-storage.json
/e2e/state.json
/e2e/log.jsonl

# rapports-mobile/tools — sessions de test Playwright (cookies/storage state, jamais versionnés)
/rapports-mobile/tools/.sessions/
# node_modules isolé de tools/ (dépendance @clerk/testing, jamais dans Frontend/package.json)
/rapports-mobile/tools/node_modules/
