# ═══════════════════════════════════════════════════════════════════════════
# Secrets de production AlloAppart — VPS Hetzner CPX21
# Copier en ".env.prod" (à la racine, à côté de docker-compose.prod.yml) et
# remplir. Ce fichier ne doit JAMAIS être commité (déjà dans .gitignore).
# ═══════════════════════════════════════════════════════════════════════════

# ─── Base de données Postgres ────────────────────────────────────────────────
POSTGRES_USER=allo
POSTGRES_PASSWORD=                         # générer : openssl rand -base64 32
POSTGRES_DB=allo_appart

# ─── Recherche (Meilisearch) ─────────────────────────────────────────────────
MEILI_MASTER_KEY=                          # générer : openssl rand -base64 32

# ─── Temps réel (Soketi — compatible protocole Pusher) ───────────────────────
SOKETI_APP_ID=allo-appart-prod
SOKETI_APP_KEY=                            # générer : openssl rand -hex 20
SOKETI_APP_SECRET=                         # générer : openssl rand -hex 20

# ─── Auth (Clerk) — dashboard Clerk > API Keys (mode LIVE, pas test) ─────────
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# ─── Paiement (PayDunya) — dashboard PayDunya > Live Keys ────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ─── Stockage photos (Cloudinary) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Notifications push (OneSignal) ──────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── Email (SMTP / Nodemailer) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@alloappart.sn
SMTP_PASS=
SMTP_FROM=Allo-Appart <noreply@alloappart.sn>

# ─── URLs publiques ───────────────────────────────────────────────────────────
FRONTEND_URL=https://alloappart.sn
BACKEND_URL=https://api.alloappart.sn
