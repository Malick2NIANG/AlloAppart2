generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  clerkId       String         @unique
  email         String         @unique
  phone         String?
  firstName     String
  lastName      String
  bio           String?        @db.Text
  avatar        String?
  coverageZone  String?        @db.VarChar(200)
  /// Langue de communication (emails, SMS, notifications). Synchronisée depuis le frontend.
  locale        String         @default("fr") @db.VarChar(5)
  roles         Role[]         @default([LOCATAIRE])
  agencyName               String?        // Renseigné uniquement pour PRO_AGENCE
  agencySlug               String?        @unique @db.VarChar(80) // Slug URL unique ex: immobilier-dakar
  profileViews             Int            @default(0) // Compteur de visites de la vitrine
  bailleurTermsAcceptedAt  DateTime?      // null = jamais accepté
  isVerified               Boolean        @default(false)
  isSuspended              Boolean        @default(false)
  mustChangePassword       Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bookings              Booking[]      @relation("TenantBookings")
  listings              Listing[]
  sentMessages          Message[]
  reviews               Review[]       @relation("AuthorReviews")
  verifications         Verification[] @relation("AgentVerifications")
  preferredVerifications Verification[] @relation("PreferredAgentVerifications")
  rooms                 MessageRoom[]  @relation("RoomParticipants")
  favorites             Listing[]      @relation("UserFavorites")
  subscription          Subscription?
  notifications         Notification[]
  agentRatings          AgentRating[]  @relation("AgentRatings")
  givenRatings          AgentRating[]  @relation("GivenRatings")
  reports               Report[]       @relation("UserReports")

  @@map("users")
}

model Listing {
  id           String        @id @default(uuid())
  title        String
  description  String
  price         Decimal       @db.Decimal(12, 2)   // Tarif mensuel (référence principale, affichage/tri)
  pricePerNight Decimal?      @db.Decimal(12, 2)   // Tarif par nuit (mode NIGHTLY ou MIXED)
  minimumNights Int?                                // Durée minimum de séjour en nuits
  maximumNights Int?                                // Séjour maximum en nuits — optionnel, mode NIGHTLY uniquement
  // --- Système de location hybride (mensuel / nuitée / mixte) ---
  rentalMode     RentalMode @default(NIGHTLY) // Mode de location proposé par le bailleur
  cleaningFee    Decimal?   @db.Decimal(12, 2) // Frais de ménage fixes (mode NIGHTLY ou MIXED)
  depositMonths  Int?                          // Caution exprimée en nombre de mois de loyer (mode MONTHLY ou MIXED)
  chargesIncluded Boolean?                     // Charges (eau/électricité) incluses dans le loyer mensuel ou non
  minLeaseMonths Int?                          // Durée minimale de bail en mois (mode MONTHLY ou MIXED)
  type         ListingType
  status       ListingStatus @default(DRAFT)
  isVerified   Boolean       @default(false)
  verifiedAt   DateTime?
  lat          Float
  lng          Float
  city         String
  region       String
  address      String?
  rooms        Int?
  surface      Float?
  boostUntil   DateTime?
  boostScore   Int           @default(0)
  images       String[]
  tourUrl      String?
  amenities    String[]
  ownerId      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  baths        Int?
  beds         Int?
  bookings     Booking[]
  owner        User          @relation(fields: [ownerId], references: [id])
  messageRooms  MessageRoom[]
  reviews       Review[]
  verifications Verification[]
  favoritedBy   User[]         @relation("UserFavorites")
  boostPayments BoostPayment[]
  reports       Report[]

  @@index([ownerId])
  @@map("listings")
}

model Booking {
  id           String        @id @default(uuid())
  listingId    String
  tenantId     String
  status       BookingStatus @default(PENDING)
  bookingType  BookingType   @default(NIGHTLY)
  startDate    DateTime      // Nuitée: date d'arrivée. Mensuel: date d'entrée souhaitée.
  endDate      DateTime?     // Nuitée: obligatoire (validé au niveau DTO). Mensuel: toujours null (bail ouvert).
  totalAmount    Decimal       @db.Decimal(12, 2)
  platformFee    Decimal?      @db.Decimal(12, 2)
  landlordAmount Decimal?      @db.Decimal(12, 2)
  escrowStatus   EscrowStatus  @default(AWAITING_PAYMENT)
  paymentRef   String?
  // Mode MONTHLY : caution encaissée à la réservation, snapshotée au moment de la
  // demande (indépendante d'un changement ultérieur de listing.depositMonths/price).
  depositAmount  Decimal?      @db.Decimal(12, 2)
  terminatedAt   DateTime?     // Date de résiliation du bail (mode MONTHLY)
  // Signalement de non-conformité AlloVérifié (Article 9 des CGU) — fenêtre de
  // 24h après l'entrée dans les lieux pour contester l'état du bien.
  disputeReason      String?
  disputeEvidence    String[]  @default([])
  disputedAt         DateTime?
  disputeResolvedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  listing      Listing       @relation(fields: [listingId], references: [id])
  tenant       User          @relation("TenantBookings", fields: [tenantId], references: [id])
  review       Review?
  documents    BookingDocument[]
  contract     Contract?

  @@index([tenantId])
  @@index([listingId])
  @@index([paymentRef])
  @@map("bookings")
}

model BookingDocument {
  id         String       @id @default(uuid())
  bookingId  String
  type       DocumentType
  fileUrl    String
  uploadedAt DateTime     @default(now())
  booking    Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_documents")
}

model Contract {
  id                  String         @id @default(uuid())
  bookingId           String         @unique
  type                ContractType
  status              ContractStatus @default(DRAFT)
  pdfUrl               String?        // PDF généré non signé
  firstSignedPdfUrl    String?        // PDF re-téléversé après signature de la 1ère partie
  finalPdfUrl          String?        // PDF final, les deux parties ont signé
  firstSignedById      String?        // userId de la 1ère partie à avoir signé
  firstSignedAt        DateTime?
  secondSignedAt       DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  booking              Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("contracts")
}

model Verification {
  id                String      @id @default(uuid())
  listingId         String
  agentId           String?
  preferredAgentId  String?     // Agent demandé par le bailleur (optionnel, non contraignant)
  status            VerifStatus @default(REQUESTED)
  reportUrl         String?
  auditType         AuditType   @default(BASIC)
  scheduledAt       DateTime
  completedAt       DateTime?
  notes             String?
  declineReason     String?     // Motif si agent décline
  photos            String[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  agent             User?       @relation("AgentVerifications", fields: [agentId], references: [id])
  preferredAgent    User?       @relation("PreferredAgentVerifications", fields: [preferredAgentId], references: [id])
  listing           Listing     @relation(fields: [listingId], references: [id])
  rating            AgentRating?

  @@map("verifications")
}

model MessageRoom {
  id           String    @id @default(uuid())
  listingId    String
  createdAt    DateTime  @default(now())
  listing      Listing   @relation(fields: [listingId], references: [id])
  messages     Message[]
  participants User[]    @relation("RoomParticipants")

  @@index([listingId])
  @@map("message_rooms")
}

model Message {
  id          String      @id @default(uuid())
  roomId      String
  senderId    String
  content     String
  readAt      DateTime?
  editedAt    DateTime?
  deletedAt   DateTime?
  replyToId   String?
  createdAt   DateTime    @default(now())
  room        MessageRoom @relation(fields: [roomId], references: [id])
  sender      User        @relation(fields: [senderId], references: [id])
  replyTo     Message?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies     Message[]   @relation("MessageReplies")

  @@index([roomId])
  @@index([senderId])
  @@index([replyToId])
  @@map("messages")
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  listingId String
  authorId  String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  author    User     @relation("AuthorReviews", fields: [authorId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@index([authorId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String   // ex: VERIF_ASSIGNED, VERIF_SCHEDULED, VERIF_DONE, VERIF_DECLINED
  title     String
  body      String
  isRead    Boolean  @default(false)
  metadata  Json?    // { verificationId, listingTitle, listingId }
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Role {
  LOCATAIRE
  BAILLEUR
  AGENT_TERRAIN
  PRO_AGENCE
  ADMIN
}

enum ListingType {
  APPARTEMENT
  VILLA
  CHAMBRE
  STUDIO
  BUREAU
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RENTED
  SUSPENDED
}

enum RentalMode {
  NIGHTLY
  MONTHLY
  MIXED
}

enum BookingType {
  NIGHTLY
  MONTHLY
}

enum BookingStatus {
  // Commun / nuitée
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  // Mensuel (bail)
  REQUESTED
  APPROVED
  REJECTED
  ACTIVE
  TERMINATED
}

enum DocumentType {
  ID_CARD
  PROOF_OF_INCOME
  GUARANTOR
}

enum ContractType {
  SEASONAL
  HABITATION
}

enum ContractStatus {
  DRAFT
  AWAITING_FIRST_SIGNATURE
  AWAITING_SECOND_SIGNATURE
  FULLY_SIGNED
}

enum EscrowStatus {
  AWAITING_PAYMENT
  HELD
  DISPUTED
  RELEASED
  REFUNDED
}

enum VerifStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  DONE
  REJECTED
  DECLINE_PENDING
}

enum AuditType {
  BASIC
  FULL
}

enum ReportReason {
  FRAUD
  WRONG_PRICE
  WRONG_PHOTOS
  ALREADY_RENTED
  WRONG_LOCATION
  OFFENSIVE
  OTHER
}

enum SubscriptionPlan {
  STARTER
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

model Subscription {
  id         String             @id @default(uuid())
  userId     String             @unique
  plan       SubscriptionPlan
  status     SubscriptionStatus @default(ACTIVE)
  monthlyFee Decimal            @db.Decimal(12, 2)
  startDate  DateTime           @default(now())
  endDate    DateTime?
  paymentRef String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  user       User               @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model AgentRating {
  id             String       @id @default(uuid())
  verificationId String       @unique          // une seule note par vérification
  agentId        String
  raterId        String                         // bailleur qui note
  rating         Int                            // 1-5
  comment        String?      @db.Text
  createdAt      DateTime     @default(now())
  agent          User         @relation("AgentRatings", fields: [agentId], references: [id])
  rater          User         @relation("GivenRatings", fields: [raterId], references: [id])
  verification   Verification @relation(fields: [verificationId], references: [id])

  @@index([agentId])
  @@map("agent_ratings")
}

model Report {
  id          String       @id @default(uuid())
  listingId   String
  reporterId  String
  reason      ReportReason
  description String?      @db.Text
  createdAt   DateTime     @default(now())

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporter User    @relation("UserReports", fields: [reporterId], references: [id])

  @@unique([listingId, reporterId])
  @@index([listingId])
  @@map("reports")
}

model BoostPayment {
  id           String   @id @default(uuid())
  listingId    String
  paymentRef   String   @unique
  status       String   @default("PENDING")
  durationDays Int      @default(7)
  createdAt    DateTime @default(now())
  listing      Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId])
  @@map("boost_payments")
}
