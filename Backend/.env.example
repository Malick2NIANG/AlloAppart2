# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/allo_appart

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Paiement (PayDunya) ─────────────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ─── Stockage photos (Cloudinary) ────────────────────────────────────────────
# L'upload est signé côté backend (SDK server) — aucun preset unsigned nécessaire
# Créer un preset "signed" dans le dashboard Cloudinary si besoin de transformations auto
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Search (Meilisearch) ────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ─── Temps réel (Soketi / Pusher-compat) ─────────────────────────────────────
SOKETI_HOST=localhost
SOKETI_PORT=6001
SOKETI_APP_ID=
SOKETI_APP_KEY=
SOKETI_APP_SECRET=

# ─── Notifications push (OneSignal) ──────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# ─── Email (SMTP / Nodemailer) ───────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@alloappart.sn
SMTP_PASS=your_app_password
SMTP_FROM=Allo-Appart <noreply@alloappart.sn>

# ─── URLs ────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
