# ─── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/allo_appart

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Clerk) ────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...

# ─── Paiement (CinetPay) ─────────────────────────────────────────────────────
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# ─── Paiement (PayDunya) fallback ────────────────────────────────────────────
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=

# ─── Stockage photos (Cloudinary) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Search (Meilisearch) ────────────────────────────────────────────────────
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_MASTER_KEY=

# ─── Temps réel (Soketi / Pusher-compat) ─────────────────────────────────────
SOKETI_HOST=localhost
SOKETI_PORT=6001
SOKETI_APP_ID=
SOKETI_APP_KEY=
SOKETI_APP_SECRET=

# ─── Notifications push (OneSignal) ──────────────────────────────────────────
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ─── URLs ────────────────────────────────────────────────────────────────────
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# ─── Serveur ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
